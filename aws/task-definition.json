{
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "family": "learn-jenkins-app-img",
  "containerDefinitions": [
    {
      "name": "springboot-img",
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        }
      ],
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "image": "211125607599.dkr.ecr.us-west-2.amazonaws.com/famora-springboot-app:35",
      "essential": true
    }
  ],
  "volumes": [],
  "networkMode": "awsvpc",
  "memory": "512",
  "cpu": "256",
  "executionRoleArn": "arn:aws:iam::211125607599:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::211125607599:role/DynamoDB_Access"
}